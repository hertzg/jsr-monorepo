{
  // A standalone import map follows the strict HTML-standard spec, not the
  // relaxed `imports` field of deno.json. The difference bites on prefix
  // mappings: here a directory mapping needs its own trailing-slash entry AND
  // the `jsr:/` form with a slash after the scheme.
  //
  //   "@std/async":  "jsr:@std/async@^1.0.0",     // the module
  //   "@std/async/": "jsr:/@std/async@^1.0.0/",   // the prefix, note `jsr:/`
  //
  // import_map.json currently enumerates every subpath instead, so this does
  // not apply today. It applies the moment someone adds a trailing slash.
  // See ADR 0001.
  "importMap": "./import_map.json",
  "minimumDependencyAge": "PT12H",
  "tasks": {
    "test": {
      "dependencies": [
        "test:doc",
        "test:parallel"
      ]
    },
    "test:parallel": "deno task test:sequential -- --parallel",
    "test:sequential": "deno test --allow-all --coverage --clean",
    "test:doc": "deno test --allow-all --coverage --clean --doc --ignore=\"**/*.test.ts,**/adr/**,.claude/**\"",
    "lint": {
      "dependencies": [
        "lint:deno",
        "lint:fmt",
        "lint:import-map",
        "lint:labeler",
        "lint:readme",
        "lint:deps"
      ]
    },
    "lint:deno": "deno lint",
    "lint:fmt": "deno fmt --check",
    "lint:import-map": "deno run -A _tools/check_import_map.ts",
    "lint:labeler": "deno run -A _tools/check_labeler.ts",
    "lint:readme": "deno run -A _tools/check_readme.ts",
    "lint:deps": "deno run -A _tools/check_deps.ts",
    "cov": "deno coverage --ignore=\"**/*.generated.mjs,**/_test_utils.ts,.github\"",
    "cov:gen": "deno task cov --lcov --output=cov.lcov",
    "cov:view": "deno task cov --html",
    "bench": "deno bench --allow-all",
    "bench:json": "deno bench --allow-all --json"
  },
  "fmt": {
    "exclude": [
      // Prose is hand-wrapped; the formatter reflows it and the result renders
      // identically, so the churn buys nothing.
      "**/*.md",
      // Release Please regenerates this on every release, in its own style.
      // Covered by the rule above, listed so the conflict stays visible.
      "**/CHANGELOG.md"
    ]
  },
  "publish": {
    // SAFETY NET ONLY. Every package declares its own `publish.exclude`, and
    // each one is expected to be correct on its own - deleting this block
    // must not change what any package ships. What a package ships is part of
    // that package's contract, so it is stated in that package's deno.json.
    //
    // Members inherit these patterns on top of their own. `publish.include`
    // does NOT inherit, which is why this is a blocklist. `deno publish`
    // always adds LICENSE and deno.json, so neither is listed anywhere.
    "exclude": [
      // Tests and benchmarks, both naming conventions.
      "**/*.test.ts",
      "**/*.bench.ts",
      "**/*_test.ts",
      "**/*_bench.ts",
      // ADRs are internal decision records, not consumer documentation.
      "**/adr/**",
      // Markdown is repo-internal. CHANGELOG stays readable on GitHub and on
      // the JSR versions tab without shipping in the tarball.
      "**/*.md"
    ]
  },
  "exclude": [
    ".git",
    ".claude",
    "cov",
    "coverage",
    "docs",
    "CLAUDE.md",
    "**/_deps.snap"
  ],
  "workspace": [
    "./packages/@binstruct/*",
    "./packages/@hertzg/*"
  ]
}
