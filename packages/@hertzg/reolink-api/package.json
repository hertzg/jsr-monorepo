{
  "name": "@hertzg/reolink-api",
  "version": "0.1.0",
  "description": "Reolink camera client over Baichuan (events, siren, privacy mode, snapshot, PTZ)",
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hertzg/jsr-monorepo.git",
    "directory": "packages/@hertzg/reolink-api"
  },
  "homepage": "https://jsr.io/@hertzg/reolink-api",
  "bugs": "https://github.com/hertzg/jsr-monorepo/issues",
  "type": "module",
  "exports": {
    ".": "./mod.ts",
    "./encoding/header": "./encoding/header.ts",
    "./encoding/cipher": "./encoding/cipher.ts",
    "./protocol/message": "./protocol/message.ts",
    "./protocol/login": "./protocol/login.ts",
    "./protocol/event": "./protocol/event.ts",
    "./protocol/xml": "./protocol/xml.ts",
    "./protocol/command": "./protocol/command.ts",
    "./protocol/params": "./protocol/params/mod.ts",
    "./protocol/commands": "./protocol/commands.ts",
    "./protocol/siren": "./protocol/siren.ts",
    "./protocol/privacy": "./protocol/privacy.ts",
    "./protocol/snapshot": "./protocol/snapshot.ts",
    "./protocol/ptz": "./protocol/ptz.ts",
    "./streams/encode": "./streams/encode.ts",
    "./streams/decode": "./streams/decode.ts",
    "./client": "./client.ts"
  },
  "files": [
    "**/*.ts",
    "!**/*.test.ts",
    "!adr/**"
  ],
  "dependencies": {
    "@hertzg/binstruct": "workspace:^",
    "@std/bytes": "npm:@jsr/std__bytes@^1.0.6",
    "@std/xml": "npm:@jsr/std__xml@^0.2.0"
  }
}
